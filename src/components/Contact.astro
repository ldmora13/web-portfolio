---
import { Mail, Github, Linkedin } from '@lucide/astro'
---

<div id="contact" class="min-h-screen flex flex-col items-center justify-center px-4 py-16 relative overflow-hidden">
	<!-- Efectos de fondo -->
	<div class="absolute top-1/4 right-1/4 w-96 h-96 bg-green-500/10 rounded-full blur-3xl animate-pulse"></div>
	<div class="absolute bottom-1/3 left-1/4 w-72 h-72 bg-green-500/5 rounded-full blur-3xl animate-pulse delay-700"></div>
	
	<h1 class="text-5xl sm:text-7xl md:text-9xl font-bold text-green-500 text-center mb-16 contact-title relative z-10">
		Contact
	</h1>
	
	<div class="max-w-2xl w-full relative z-10">
		<div class="contact-content backdrop-blur-lg bg-white/5 rounded-3xl p-8 md:p-12 border border-green-500/30 hover:border-green-500/50 transition-all duration-500 relative overflow-hidden group">
			<!-- Efecto de brillo -->
			<div class="absolute inset-0 bg-gradient-to-br from-green-500/0 via-green-500/10 to-green-500/0 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
			
			<div class="relative z-10">
				<p class="text-lg md:text-xl mb-10 text-center leading-relaxed">
					Let's work together! Feel free to reach out through any of these channels:
				</p>
				
				<div class="space-y-5">
					<a href="mailto:moraparadaluisdavid@gmail.com" 
					   class="contact-item flex items-center gap-5 p-5 rounded-2xl backdrop-blur-sm bg-white/5 border border-green-500/30 hover:border-green-500 hover:bg-white/10 transition-all duration-300 group/item relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-r from-green-500/0 via-green-500/5 to-green-500/0 translate-x-[-100%] group-hover/item:translate-x-[100%] transition-transform duration-700"></div>
						<div class="relative z-10 backdrop-blur-sm bg-green-500/20 p-4 rounded-xl border border-green-500/40">
							<Mail class="h-8 w-8 text-green-500" />
						</div>
						<div class="relative z-10">
							<p class="font-bold text-white text-lg group-hover/item:text-green-400 transition-colors">Email</p>
							<p class="text-gray-300 text-sm">moraparadaluisdavid@gmail.com</p>
						</div>
					</a>
					
					<a href="https://github.com/ldmora13" target="_blank" rel="noopener noreferrer" 
					   class="contact-item flex items-center gap-5 p-5 rounded-2xl backdrop-blur-sm bg-white/5 border border-green-500/30 hover:border-green-500 hover:bg-white/10 transition-all duration-300 group/item relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-r from-green-500/0 via-green-500/5 to-green-500/0 translate-x-[-100%] group-hover/item:translate-x-[100%] transition-transform duration-700"></div>
						<div class="relative z-10 backdrop-blur-sm bg-green-500/20 p-4 rounded-xl border border-green-500/40">
							<Github class="h-8 w-8 text-green-500" />
						</div>
						<div class="relative z-10">
							<p class="font-bold text-white text-lg group-hover/item:text-green-400 transition-colors">GitHub</p>
							<p class="text-gray-300 text-sm">@ldmora13</p>
						</div>
					</a>
					
					<a href="https://www.linkedin.com/in/luis-david-mora-337253268/" target="_blank" rel="noopener noreferrer" 
					   class="contact-item flex items-center gap-5 p-5 rounded-2xl backdrop-blur-sm bg-white/5 border border-green-500/30 hover:border-green-500 hover:bg-white/10 transition-all duration-300 group/item relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-r from-green-500/0 via-green-500/5 to-green-500/0 translate-x-[-100%] group-hover/item:translate-x-[100%] transition-transform duration-700"></div>
						<div class="relative z-10 backdrop-blur-sm bg-green-500/20 p-4 rounded-xl border border-green-500/40">
							<Linkedin class="h-8 w-8 text-green-500" />
						</div>
						<div class="relative z-10">
							<p class="font-bold text-white text-lg group-hover/item:text-green-400 transition-colors">LinkedIn</p>
							<p class="text-gray-300 text-sm">Luis David Mora</p>
						</div>
					</a>
				</div>
			</div>
		</div>
	</div>
	
	<!-- Footer -->
	<div class="relative z-10 mt-12 text-center text-gray-400 text-sm">
		<p>© 2025 Luis David Mora. Built with Astro & Tailwind CSS</p>
	</div>
</div>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	// Animación del título
	gsap.from(".contact-title", {
		scrollTrigger: {
			trigger: "#contact",
			start: "top 80%",
			end: "top 50%",
			scrub: 1,
		},
		rotation: -10,
		opacity: 0,
		scale: 0.7,
	});

	// Animación del contenedor
	gsap.from(".contact-content", {
		scrollTrigger: {
			trigger: "#contact",
			start: "top 70%",
			end: "top 30%",
			scrub: 1,
		},
		scale: 0.8,
		opacity: 0,
		y: 50,
	});

	// Animación de los items de contacto
	gsap.from(".contact-item", {
		scrollTrigger: {
			trigger: ".contact-content",
			start: "top 80%",
			end: "top 40%",
			scrub: 1,
		},
		x: -100,
		opacity: 0,
		stagger: 0.2,
	});

	// Efectos hover mejorados
	document.querySelectorAll('.contact-item').forEach((item) => {
		item.addEventListener('mouseenter', () => {
			gsap.to(item, {
				x: 15,
				scale: 1.03,
				duration: 0.3,
				ease: "power2.out"
			});
		});
		
		item.addEventListener('mouseleave', () => {
			gsap.to(item, {
				x: 0,
				scale: 1,
				duration: 0.3,
				ease: "power2.out"
			});
		});

		// Efecto de inclinación 3D
		item.addEventListener('mousemove', (e: MouseEvent) => {
			const rect = (item as HTMLElement).getBoundingClientRect();
			const x = e.clientX - rect.left - rect.width / 2;
			const y = e.clientY - rect.top - rect.height / 2;
			
			gsap.to(item, {
				rotateY: x / 20,
				rotateX: -y / 20,
				duration: 0.3,
				ease: "power2.out"
			});
		});
		
		item.addEventListener('mouseleave', () => {
			gsap.to(item, {
				rotateY: 0,
				rotateX: 0,
				duration: 0.5,
				ease: "elastic.out(1, 0.3)"
			});
		});
	});
</script>