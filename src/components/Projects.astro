---
import { ExternalLink, Github } from '@lucide/astro'
---

<div id="projects" class="min-h-screen flex flex-col items-center justify-center px-4 py-16 relative overflow-hidden">
	<!-- Efectos de fondo -->
	<div class="absolute top-1/3 right-1/4 w-72 h-72 bg-green-500/10 rounded-full blur-3xl animate-pulse"></div>
	
	<h1 class="text-5xl sm:text-7xl md:text-9xl font-bold text-green-500 text-center mb-16 project-title relative z-10">
		My Projects
	</h1>
	
	<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl relative z-10">
		<div class="project-card backdrop-blur-lg bg-white/5 rounded-3xl border border-green-500/30 p-8 hover:border-green-500 transition-all duration-500 group relative overflow-hidden">
			<!-- Efecto de brillo al hover -->
			<div class="absolute inset-0 bg-gradient-to-br from-green-500/0 via-green-500/5 to-green-500/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
			
			<div class="relative z-10">
				<div class="flex justify-between items-start mb-6">
					<h3 class="text-3xl font-bold text-green-500 group-hover:text-green-400 transition-colors">
						Jerseys Colombia
					</h3>
					<div class="flex gap-3">
						<a href="https://jerseyscol.com" target="_blank" rel="noopener noreferrer" 
						   class="text-white hover:text-green-500 transition-colors backdrop-blur-sm bg-white/10 p-2 rounded-lg hover:scale-110 transition-transform">
							<ExternalLink class="h-6 w-6" />
						</a>
					</div>
				</div>
				
				<p class="text-gray-300 text-lg mb-6 leading-relaxed">
					E-commerce platform for Colombian soccer, NBA and F1 jerseys. Built with modern web technologies featuring a responsive design, shopping cart, wishlist, user authentication, payment methods, tracking and order history.
				</p>
				
				<div class="flex flex-wrap gap-2 mb-4">
					<span class="px-4 py-2 backdrop-blur-sm bg-green-500/20 text-green-400 rounded-full text-sm font-semibold border border-green-500/30 hover:bg-green-500/30 transition-colors">
						React
					</span>
					<span class="px-4 py-2 backdrop-blur-sm bg-green-500/20 text-green-400 rounded-full text-sm font-semibold border border-green-500/30 hover:bg-green-500/30 transition-colors">
						Tailwind
					</span>
					<span class="px-4 py-2 backdrop-blur-sm bg-green-500/20 text-green-400 rounded-full text-sm font-semibold border border-green-500/30 hover:bg-green-500/30 transition-colors">
						JavaScript
					</span>
				</div>
			</div>
		</div>

		<!-- Placeholder para más proyectos -->
		<div class="project-card backdrop-blur-lg bg-white/5 rounded-3xl border border-green-500/30 p-8 hover:border-green-500 transition-all duration-500 group relative overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-br from-green-500/0 via-green-500/5 to-green-500/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
			
			<div class="relative z-10 h-full flex flex-col justify-center items-center text-center">
				<div class="w-20 h-20 mb-6 rounded-full backdrop-blur-sm bg-green-500/20 flex items-center justify-center border border-green-500/30">
					<span class="text-4xl">🚀</span>
				</div>
				<h3 class="text-2xl font-bold text-green-500 mb-4">
					More Projects Coming Soon
				</h3>
				<p class="text-gray-400">
					Currently working on exciting new projects. Stay tuned!
				</p>
			</div>
		</div>
	</div>
</div>